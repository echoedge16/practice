class Solution:
    def maxVowels(self, s: str, k: int) -> int:
        ans=vowel=0
        for i,c in enumerate(s):
            if c in set("aeiou"):
                vowel+=1   
            if i>=k:
                if s[i-k] in set("aeiou"):
                    vowel-=1
            ans=max(ans,vowel)
        return ans             
