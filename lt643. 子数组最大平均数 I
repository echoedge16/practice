class Solution:
    def findMaxAverage(self, nums: list[int], k: int) -> float:
        sum=0
        ans=-float('inf')
        ave=0
        for i,w in enumerate(nums):
            sum+=w
            if i>=k-1:
                ave=sum/k
                ans=max(ans,ave)
                sum-=nums[i-k+1]
