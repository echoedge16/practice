题解
class Solution:
    def findMaxAverage(self, nums: list[int], k: int) -> float:
        
        maxTotal = total = sum(nums[:k])
        n = len(nums)

        for i in range(k, n):
            total = total - nums[i - k] + nums[i]
            maxTotal = max(maxTotal, total)
        
        return maxTotal / k
