a,b,c,d=map(float,input().split())
ans=[]
for i in range(-100,101):
    x=i
    y=i+1
    fx=a*x**3+b*x**2+c*x+d
    fy=a*y**3+b*y**2+c*y+d
    if fx*fy < 0:
        for _ in range(120):
            mid=(x+y)/2
            fz=a*mid**3+b*mid**2+c*mid+d
            if fz*fx < 0:
                y=mid
            else:
                x=mid
        ans.append((x+y)/2)
print("{0:.2f} {1:.2f} {2:.2f}".format(*ans))
