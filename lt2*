暴力
class Solution:
    def isPowerOfTwo(self, n: int) -> bool:
        if n<1:
            return False
        if n==1:
            return True
        while True:
            n/=2
            if n==1.0:
                return True
                break
            elif n<1.0:
                return False
                break
优解
class Solution:
    def isPowerOfTwo(self, n: int) -> bool:
        return n>0 and (n&(n-1))==0
