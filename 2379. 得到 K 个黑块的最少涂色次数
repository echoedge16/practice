class Solution:
    def minimumRecolors(self, blocks: str, k: int) -> int:
        window_w = 0
        for i in range(k):
            if blocks[i] == 'W':
                window_w += 1
        ans = window_w
        for r in range(k, len(blocks)):
            if blocks[r] == 'W':
                window_w += 1
            l = r - k
            if blocks[l] == 'W':
                window_w -= 1
            ans = min(ans, window_w)
        return ans
