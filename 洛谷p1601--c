#include <stdio.h>
#include <string.h>
int main(){
    char s1[510],s2[510];
    int a[510]={0},b[510]={0},c[510]={0};
    int len1,len2,len_max,i;
    scanf("%s",s1);
    scanf("%s",s2);
    len1=strlen(s1);
    len2=strlen(s2);
    for(i=0;i<len1;i++)
        a[len1-i]=s1[i]-'0';
    for(i=0;i<len2;i++)
        b[len2-i]=s2[i]-'0';
    len_max=(len1>len2)?len1:len2;
    for(i=1;i<=len_max;i++){
        c[i]+=a[i]+b[i];
        c[i+1]=c[i]/10;
        c[i]%=10;
    }
    if(c[len_max+1]>0)
        len_max++;
    for(i=len_max;i>=1;i--)
        printf("%d",c[i]);
    printf("\n");
    return 0;
}
